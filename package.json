{
  "name": "openregard",
  "version": "0.1.0",
  "description": "Configurable display preferences for accessible websites: dependency-free core, native widget, optional React binding.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inferal-oss/openregard.git"
  },
  "homepage": "https://github.com/inferal-oss/openregard#readme",
  "bugs": "https://github.com/inferal-oss/openregard/issues",
  "keywords": [
    "accessibility",
    "display-preferences",
    "a11y",
    "react",
    "vanilla"
  ],
  "files": [
    "dist",
    "docs",
    "examples",
    "NOTICE",
    "scripts/demo.mjs",
    "scripts/serve.mjs",
    "CONTRIBUTING.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./style.css": "./dist/style.css",
    "./browser.js": "./dist/browser.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build:site && playwright test",
    "test:package": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package",
    "prepack": "npm run build",
    "demo": "node scripts/demo.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "site": "node scripts/serve-site.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "marked": "^18.1.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "bin": {
    "openregard-demo": "scripts/demo.mjs"
  }
}
